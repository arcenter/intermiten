<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource surface-a0}"/>
        <Setter Property="Foreground" Value="{StaticResource light-a0}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource surface-a50}" />
        <Setter Property="SelectionTextBrush" Value="{StaticResource surface-a20}"/>
        <Setter Property="Padding" Value="5,5,5,5" />
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder" Background="{StaticResource surface-a10}" BorderBrush="{StaticResource surface-a30}" BorderThickness="0">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="RoundedTextBox">
        <Setter Property="Background" Value="{StaticResource surface-a0}"/>
        <Setter Property="Foreground" Value="{StaticResource light-a0}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource surface-a50}" />
        <Setter Property="SelectionTextBrush" Value="{StaticResource surface-a20}"/>
        <Setter Property="Padding" Value="10,5,10,5" />
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder" Background="{StaticResource surface-a10}" BorderBrush="{StaticResource surface-a30}" BorderThickness="0" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="RoundedTextBoxTransparent">
        <Setter Property="Background" Value="{StaticResource surface-a0}"/>
        <Setter Property="Foreground" Value="{StaticResource light-a0}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource surface-a50}" />
        <Setter Property="SelectionTextBrush" Value="{StaticResource surface-a20}"/>
        <Setter Property="Padding" Value="10,5,10,5" />
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder" BorderBrush="{StaticResource surface-a30}" BorderThickness="2" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="TransparentTextBox">
        <Setter Property="Background" Value="{StaticResource surface-a0}"/>
        <Setter Property="Foreground" Value="{StaticResource light-a0}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource surface-a50}" />
        <Setter Property="SelectionTextBrush" Value="{StaticResource surface-a20}"/>
        <Setter Property="Padding" Value="10,5,10,5" />
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder" BorderThickness="0">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>