<Application x:Class="intermiten.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:intermiten"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Dictionaries/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Dictionaries/Icons.xaml"/>
                <ResourceDictionary Source="/Resources/Dictionaries/ScrollViewers.xaml"/>
                <ResourceDictionary Source="/Resources/Dictionaries/TextBoxes.xaml"/>
                <ResourceDictionary Source="/Resources/Dictionaries/Labels.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>