<Window x:Class="intermiten.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:intermiten"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800"
        Title="Inturosa" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MinWidth="404" MinHeight="35"
        Width="1250" Height="500"
        AllowsTransparency="True"
        Background="Transparent"
        KeyboardNavigation.DirectionalNavigation="None">

    <Grid Background="{StaticResource surface-a0}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43*"/>
            <ColumnDefinition Width="757*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label x:Name="versionLabel" Foreground="{StaticResource surface-a10}" Padding="0" FontFamily="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Semibold" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="0 0 3 0"/>
        
        <Frame x:Name="FrameView" NavigationUIVisibility="Hidden" Focusable="False" IsTabStop="False" Grid.Row="1" Grid.ColumnSpan="2"/>

        <Border x:Name="TitleBar" Background="{StaticResource surface-a10}" MouseDown="TitleBar_MouseDown" Grid.ColumnSpan="2"/>

        <Grid Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="MinimizeButton" Grid.Column="2" IsMouseDirectlyOverChanged="MinimizeButton_IsMouseDirectlyOverChanged" MouseDown="MinimizeButton_MouseDown">
                <Border.Background>
                    <SolidColorBrush Color="{Binding Color, Source={StaticResource primary-a0}}" Opacity="0"/>
                </Border.Background>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="MinimizeX1" Data="M0,0 L10,0" Stroke="{StaticResource light-a0}" StrokeThickness="1" IsHitTestVisible="False" Opacity="0.25"/>
                </Grid>
            </Border>

            <Border x:Name="MaximizeButton" Grid.Column="3" IsMouseDirectlyOverChanged="MaximizeButton_IsMouseDirectlyOverChanged" MouseDown="MaximizeButton_MouseDown">
                <Border.Background>
                    <SolidColorBrush Color="{Binding Color, Source={StaticResource primary-a0}}" Opacity="0"/>
                </Border.Background>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle x:Name="MaximizeRect" Width="10" Height="10" Stroke="{StaticResource light-a0}" StrokeThickness="1" IsHitTestVisible="False" Opacity="0.25"/>
                </Grid>
            </Border>

            <Border x:Name="CloseButton" Grid.Column="4" IsMouseDirectlyOverChanged="CloseButton_IsMouseDirectlyOverChanged" MouseDown="CloseButton_MouseDown">
                <Border.Background>
                    <SolidColorBrush Color="{Binding Color, Source={StaticResource primary-a0}}" Opacity="0"/>
                </Border.Background>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="X1" Data="M0,0 L10,10" Stroke="{StaticResource light-a0}" StrokeThickness="1" IsHitTestVisible="False" Opacity="0.25"/>
                    <Path x:Name="X2" Data="M0,10 L10,0" Stroke="{StaticResource light-a0}" StrokeThickness="1" IsHitTestVisible="False" Opacity="0.25"/>
                </Grid>
            </Border>

            <Image x:Name="AppIcon" Source="/Resources/Icons/icon.ico" Width="15" Height="15"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Label Content="intermiten" Foreground="{StaticResource light-a0}" VerticalContentAlignment="Center" Padding="0" FontFamily="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Light" FontSize="11"/>
                <Label x:Name="WindowTitle" Foreground="{StaticResource primary-a0}" VerticalContentAlignment="Center" Padding="0" FontFamily="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Semibold" FontSize="11" Margin="2 0 0 0"/>
            </StackPanel>

        </Grid>

        <!--https://gist.github.com/JoshClose/1367657-->

        <Border x:Name="ResizeRectangles" BorderThickness="0" Grid.RowSpan="2" d:Visibility="Collapsed" Grid.ColumnSpan="2">
            <Grid>
                <Rectangle x:Name="ResizeN" Fill="Transparent" VerticalAlignment="Top" Height="10" Margin="9,-2,9,0" MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />
                <Rectangle x:Name="ResizeS" Fill="Transparent" VerticalAlignment="Bottom" Height="10" Margin="9,0,9,-2" MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />
                <Rectangle x:Name="ResizeW" Fill="Transparent" HorizontalAlignment="Left" Width="10" Margin="-2,9,0,9" MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />
                <Rectangle x:Name="ResizeE" Fill="Transparent" HorizontalAlignment="Right" Width="10" Margin="0,9,-2,9"  MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />

                <Rectangle x:Name="ResizeNW" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Width="10" Height="10" Margin="-2,-2,0,0"  MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />
                <Rectangle x:Name="ResizeNE" Fill="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Margin="0,-2,-2,0"  MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />
                <Rectangle x:Name="ResizeSW" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="10" Height="10" Margin="-2,0,0,-2"  MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />
                <Rectangle x:Name="ResizeSE" Fill="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="10" Margin="0,0,-2,-2"  MouseEnter="DisplayResizeCursor" MouseLeave="ResetCursor" PreviewMouseLeftButtonDown="Resize" />
            </Grid>
        </Border>

        <Border x:Name="WindowBorder" BorderBrush="{StaticResource surface-a20}" BorderThickness="1" Grid.RowSpan="2" d:Visibility="Collapsed" Grid.ColumnSpan="2"/>

    </Grid>

</Window>