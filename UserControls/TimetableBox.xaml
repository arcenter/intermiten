<UserControl x:Name="TTB" x:Class="intermiten.UserControls.TimetableBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:intermiten.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100">

    <ScrollViewer Style="{StaticResource MiniCustomScrollViewerStyle}" Margin="2" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <StackPanel x:Name="stackPanel"/>
    </ScrollViewer>

</UserControl>
