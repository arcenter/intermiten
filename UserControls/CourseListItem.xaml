<UserControl x:Class="intermiten.UserControls.CourseListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:intermiten.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="800"
             Cursor="Hand">

    <Grid x:Name="ucGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition />
            <RowDefinition Height="12" />
        </Grid.RowDefinitions>

        <Border x:Name="SelectionBackground" Background="{StaticResource surface-a50}" Opacity="0" Grid.Row="1" CornerRadius="5" MinHeight="36" BorderThickness="0" Width="{Binding ActualWidth, ElementName=Background, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=Background, Mode=OneWay}"/>

        <Border x:Name="StrokeBorder" Grid.Row="1" CornerRadius="5" BorderBrush="{StaticResource primary-a20}" BorderThickness="0" Width="{Binding ActualWidth, ElementName=Background, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=Background, Mode=OneWay}"/>

        <Border x:Name="Background" Background="{StaticResource primary-a0}" Opacity="0" Grid.Row="1" CornerRadius="5" MinHeight="36" MouseEnter="Background_MouseEnter" MouseLeave="Background_MouseLeave" MouseDown="Background_MouseDown"/>

        <Line VerticalAlignment="Bottom" Stroke="{StaticResource surface-a50}" StrokeThickness="2" X2="{Binding ActualWidth, ElementName=Background}" Grid.Row="2" Opacity="0.25" IsHitTestVisible="False"/>

        <Grid VerticalAlignment="Center" Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border x:Name="CheckBox" BorderBrush="{StaticResource primary-a0}" BorderThickness="2" CornerRadius="2" HorizontalAlignment="Center" Width="14" Height="14" IsHitTestVisible="False">
                <Path Data="M1,4 L4,6 L7,1" x:Name="checkMark" Stroke="{StaticResource primary-a20}" Width="8" Height="8" Margin="0 1 0 0" StrokeThickness="2" IsHitTestVisible="False" Opacity="0" />
            </Border>

            <Grid Grid.Column="1">
                <DockPanel x:Name="taskNameAndTag" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}">
                    <TextBlock x:Name="courseNameTextbox" FontFamily="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular" Foreground="{StaticResource light-a0}" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,0,13,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left"/>
                </DockPanel>
            </Grid>
        </Grid>
        
    </Grid>
</UserControl>