<UserControl x:Class="intermiten.UserControls.CourseBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:intermiten.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="800"
             Opacity="0" d:Opacity="1">

    <Grid>
        <Border x:Name="Background" Opacity="0.75" CornerRadius="5" MouseEnter="Background_MouseEnter" MouseLeave="Background_MouseLeave" BorderBrush="Red" BorderThickness="0"/>
        <StackPanel VerticalAlignment="Center" Margin="5">
            <TextBlock x:Name="courseIDTextbox" FontFamily="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular" Foreground="{StaticResource light-a0}" FontSize="6" HorizontalAlignment="Left" Padding="0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="courseNameTextBox" FontFamily="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular" Foreground="{StaticResource light-a0}" FontSize="11" HorizontalAlignment="Left" Padding="0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="sectionRoomTextBox" FontFamily="/intermiten;component/Resources/Fonts/Manrope.ttf#Manrope Regular" Foreground="{StaticResource light-a0}" FontSize="9" HorizontalAlignment="Left" Padding="0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
    
</UserControl>